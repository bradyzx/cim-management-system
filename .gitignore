# 操作系统文件
.DS_Store
Thumbs.db

# IDE / 编辑器配置
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.sublime-workspace

# 日志文件
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 环境变量与敏感信息（非常重要！）
.env
.env.*
!.env.example  # 通常保留示例文件

# 临时文件
*.tmp
*.temp
*.swp
*~

# 依赖包（体积巨大，由 package.json 管理）
node_modules/
jspm_packages/

# 构建输出目录（每次构建都会重新生成）
dist/
build/
out/
.nuxt/
.vuepress/dist/
dist-ssr/

# 缓存文件
.cache/
.vite/
.eslintcache
*.tsbuildinfo

# 测试覆盖率报告
coverage/

# 包管理器锁文件（团队需统一，可选忽略一种）
# package-lock.json
# yarn.lock
# pnpm-lock.yaml


# 编译输出目录
target/          # Maven
build/           # Gradle
bin/
out/

# 编译产物
*.class
*.jar
*.war
*.ear

# 构建工具缓存
.gradle/
.settings/
.classpath
.project

# Spring Boot 特定
*.original
.sts4-cache/


# 字节码与缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境（本地依赖，不应提交）
venv/
.venv/
env/
ENV/

# Django 特定
*.log
local_settings.py
staticfiles/     # collectstatic 生成的文件
media/           # 用户上传的媒体文件

# 数据库文件（SQLite 等本地开发数据库）
*.sqlite3
db.sqlite3